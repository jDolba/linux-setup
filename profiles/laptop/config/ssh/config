# Managed laptop SSH configuration. Private keys remain only in keyKeeper.
# Public companions in ~/.ssh select matching temporary agent identities.
#
# Note for AI agents: The ssh-agent may not have the proper key loaded to prevent automated access to certain remotes.

Include ~/.ssh/config.d/*.conf

Host xemel.srv.omnicado.com
    User root
    IdentityFile ~/.ssh/omnicado_xemel.pub
    IdentitiesOnly yes

Host gitlabcom-moravio
    HostName gitlab.com
    IdentityFile ~/.ssh/gitlabcom_moravio_ed25519.pub
    IdentitiesOnly yes

Host hetzner-dolba-1
    HostName 78.47.21.162
    User deploy
    IdentityFile ~/.ssh/hetzner-dolba-1.pub
    IdentitiesOnly yes

# With no matching unlocked identity, these hosts cannot authenticate.
Host *
    BatchMode yes
