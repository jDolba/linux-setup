# Managed laptop SSH configuration. Private keys remain only in keyKeeper.
# key-keeper-unlock creates the corresponding root-managed public identity here.
Include ~/.ssh/config.d/*.conf

Host xemel.srv.omnicado.com
    User root
    IdentityFile /var/lib/key-keeper/public/omnicado_xemel.pub
    IdentitiesOnly yes

Host gitlabcom-moravio
    HostName gitlab.com
    IdentityFile /var/lib/key-keeper/public/gitlabcom_moravio.pub
    IdentitiesOnly yes

Host hetzner-dolba-1
    HostName 78.47.21.162
    User deploy
    IdentityFile /var/lib/key-keeper/public/hetzner-dolba-1.pub
    IdentitiesOnly yes

# Only named identities may be offered. With no loaded identity, authentication fails.
Host *
    IdentitiesOnly yes
    BatchMode yes
