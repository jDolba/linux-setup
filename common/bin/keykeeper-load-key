#!/usr/bin/env bash
# Temporarily add one keyKeeper identity to this user's running SSH agent.
set -Eeuo pipefail

readonly KEYKEEPER_USER=keyKeeper
readonly DEFAULT_MINUTES=5
readonly MAX_MINUTES=1440

usage() {
    printf 'Usage: keykeeper-load-key <key-name> [minutes]\n' >&2
}

die() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

key_name="${1:-}"
minutes="${2:-$DEFAULT_MINUTES}"
[[ $# -le 2 ]] || { usage; exit 2; }
[[ "$key_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die 'Key name must be a simple filename inside keyKeeper/.ssh.'
[[ "$minutes" =~ ^[1-9][0-9]*$ ]] || die 'Minutes must be a positive integer.'
((minutes <= MAX_MINUTES)) || die "Minutes must not exceed $MAX_MINUTES."
[[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]] || die 'No running SSH agent was found. Start one, then retry.'

keykeeper_home="$(getent passwd "$KEYKEEPER_USER" | cut -d: -f6)"
[[ -n "$keykeeper_home" ]] || die 'keyKeeper does not exist. Run bootstrap first.'
key_path="$keykeeper_home/.ssh/$key_name"
public_dir="$HOME/.ssh/linux-setup-identities"
public_path="$public_dir/$key_name.pub"
temporary_public="$(mktemp)"

cleanup() {
    rm -f "$temporary_public"
}
trap cleanup EXIT

sudo -u "$KEYKEEPER_USER" -- test -f "$key_path" || die "No keyKeeper key named '$key_name'."
install -d -m 0700 "$public_dir"
sudo -u "$KEYKEEPER_USER" -- ssh-keygen -y -f "$key_path" > "$temporary_public"
install -m 0600 "$temporary_public" "$public_path"

# ssh-agent accepts connections only from its owner. Stream the private key directly
# from keyKeeper into this user's ssh-add process; it is never written under $HOME.
sudo -u "$KEYKEEPER_USER" -- cat "$key_path" | ssh-add -t "${minutes}m" -

printf 'Loaded %s into this SSH agent for %s minute(s).\n' "$key_name" "$minutes"
